# URL pública do site (sem barra no final). Usada em canonical, Open Graph,
# dados estruturados e sitemap.xml. Ex.: https://www.hotelpremierjanauba.com.br
VITE_SITE_URL=

# Endpoint (backend próprio, Formspree, Netlify Forms, etc.) que recebe o
# formulário de contato via POST JSON. Se ficar vazio, o formulário envia a
# mensagem pelo WhatsApp da recepção.
# Nunca coloque chaves privadas aqui: variáveis VITE_* ficam públicas no navegador.
VITE_CONTACT_ENDPOINT=
