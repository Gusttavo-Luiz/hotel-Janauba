# Copie para .env e preencha. Rode com: node --env-file=.env index.mjs

# --- GLPI (Configurar → Geral → API) ---
# Endereço da API REST, terminando em apirest.php
GLPI_API_URL=https://glpi.suaempresa.com.br/apirest.php
# Token do cliente da API (deixe vazio se o cliente não exigir App-Token)
GLPI_APP_TOKEN=
# Token de API do usuário que vai assinar as respostas (Preferências → Chaves de acesso remoto → Token de API)
GLPI_USER_TOKEN=

# --- Tess AI (tess.im → Configurações → API) ---
TESS_API_KEY=
# ID do agente de chat que fará o atendimento (número que aparece na URL do agente)
TESS_AGENT_ID=
# Opcionais: só preencha se a API da Tess pedir ou se quiser forçar
TESS_MODEL=
TESS_TEMPERATURE=
# TESS_TOOLS=no-tools
# TESS_API_URL=https://tess.pareto.io/api

# --- Comportamento (opcionais) ---
# Instruções enviadas junto com cada chamado (se vazio, usa as instruções padrão do script)
# TESS_INSTRUCOES=
# Só responde chamados com status "Novo" abertos nas últimas N horas
JANELA_HORAS=24
MAX_CHAMADOS_POR_EXECUCAO=10
# true = a resposta fica como acompanhamento privado (só técnicos veem), útil na fase de testes
ACOMPANHAMENTO_PRIVADO=false
# Texto no fim da resposta. A marca identifica chamados já respondidos: não a altere depois de entrar em uso.
# TESS_MARCA=[Assistente virtual]
# TESS_ASSINATURA=Esta é uma resposta automática do nosso assistente virtual. Um técnico vai dar continuidade ao seu chamado.
# true = mostra as respostas no terminal sem publicar no GLPI
DRY_RUN=false
